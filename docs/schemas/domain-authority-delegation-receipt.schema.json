{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://document-harness.local/schemas/domain-authority-delegation-receipt.schema.json",
  "title": "Domain Authority Delegation Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "receiptId", "decision", "allowedDecisionTier", "allowedChangeClasses", "forbiddenChangeClasses", "decidedBy", "decidedAt", "reason"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "kind": { "const": "domain-authority-delegation" },
    "receiptId": { "type": "string", "minLength": 1 },
    "decision": { "const": "approved" },
    "allowedDecisionTier": { "const": "routine" },
    "allowedChangeClasses": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "forbiddenChangeClasses": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "decidedBy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actorKind", "identifier"],
      "properties": {
        "actorKind": { "const": "human" },
        "identifier": { "type": "string", "minLength": 1 }
      }
    },
    "decidedAt": { "type": "string", "format": "date-time" },
    "reason": { "type": "string", "minLength": 1 }
  }
}
