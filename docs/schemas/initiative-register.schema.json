{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://document-harness.dev/schemas/initiative-register.schema.json",
  "title": "Repository Initiative Register",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "initiatives"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "initiatives": {
      "type": "array",
      "items": { "$ref": "#/$defs/initiative" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "repositoryRevision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "safePath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "heading", "lineStart", "lineEnd", "capturedSha256", "capturedRepositoryRevision"],
      "properties": {
        "path": { "$ref": "#/$defs/safePath" },
        "heading": { "type": "string", "minLength": 1 },
        "lineStart": { "type": "integer", "minimum": 1 },
        "lineEnd": { "type": "integer", "minimum": 1 },
        "evidenceKind": { "type": "string" },
        "note": { "type": ["string", "null"] },
        "capturedSha256": { "$ref": "#/$defs/sha256" },
        "capturedRepositoryRevision": { "$ref": "#/$defs/repositoryRevision" }
      }
    },
    "policyRelationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyId", "relation", "rationale", "exceptionRef"],
      "properties": {
        "policyId": { "type": "string", "minLength": 1 },
        "relation": { "enum": ["advances", "constrained-by", "exception-to"] },
        "rationale": { "type": "string", "minLength": 1 },
        "exceptionRef": { "anyOf": [{ "$ref": "#/$defs/safePath" }, { "type": "null" }] }
      },
      "allOf": [
        {
          "if": { "properties": { "relation": { "const": "exception-to" } }, "required": ["relation"] },
          "then": { "properties": { "exceptionRef": { "$ref": "#/$defs/safePath" } } }
        }
      ]
    },
    "guidelineRelationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["guidelineId", "adoption", "rationale", "verification"],
      "properties": {
        "guidelineId": { "type": "string", "minLength": 1 },
        "adoption": { "enum": ["required", "recommended"] },
        "rationale": { "type": "string", "minLength": 1 },
        "verification": { "type": "string", "minLength": 1 }
      }
    },
    "initiative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "kind", "title", "humanSummary", "outcome", "whyNow", "lifecycleState",
        "approvalState", "owner", "currentFocus", "policyRefs", "policyRelationships", "guidelineRefs", "guidelineRelationships",
        "guidelineDisposition", "guidelineDispositionReason", "legacyProjectRefs", "successSignals", "risks", "documentRef", "effectiveRef", "decisionReceiptRef",
        "sourceRevision", "sourceRefs"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^(?:I[0-9]{4}|INIT-[A-Z0-9][A-Z0-9-]*)$" },
        "kind": { "const": "initiative" },
        "title": { "type": "string", "minLength": 1 },
        "humanSummary": { "type": "string", "minLength": 1 },
        "outcome": { "type": "string", "minLength": 1 },
        "whyNow": { "type": "string", "minLength": 1 },
        "lifecycleState": { "enum": ["draft", "active", "blocked", "done", "cancelled", "superseded"] },
        "approvalState": { "enum": ["unreviewed", "review_requested", "approved", "rejected", "stale", "superseded"] },
        "owner": { "type": "string", "minLength": 1 },
        "currentFocus": { "type": "string", "minLength": 1 },
        "policyRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "policyRelationships": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/policyRelationship" } },
        "guidelineRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "guidelineRelationships": { "type": "array", "items": { "$ref": "#/$defs/guidelineRelationship" } },
        "guidelineDisposition": { "enum": ["linked", "no_applicable_guideline", "needs_review"] },
        "guidelineDispositionReason": { "type": "string", "minLength": 1 },
        "legacyProjectRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "path"],
            "properties": {
              "id": { "type": "string", "pattern": "^P[0-9]{4}$" },
              "path": { "$ref": "#/$defs/safePath" }
            }
          }
        },
        "successSignals": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "risks": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "documentRef": { "anyOf": [{ "$ref": "#/$defs/safePath" }, { "type": "null" }] },
        "effectiveRef": { "anyOf": [{ "$ref": "#/$defs/safePath" }, { "type": "null" }] },
        "decisionReceiptRef": { "anyOf": [{ "$ref": "#/$defs/safePath" }, { "type": "null" }] },
        "sourceRevision": { "$ref": "#/$defs/repositoryRevision" },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceRef" } }
      },
      "allOf": [
        {
          "if": { "properties": { "id": { "pattern": "^I[0-9]{4}$" } }, "required": ["id"] },
          "then": { "properties": { "documentRef": { "$ref": "#/$defs/safePath" } } }
        },
        {
          "if": { "properties": { "id": { "pattern": "^INIT-" } }, "required": ["id"] },
          "then": {
            "properties": {
              "lifecycleState": { "const": "draft" },
              "approvalState": { "enum": ["unreviewed", "review_requested", "rejected", "stale", "superseded"] },
              "documentRef": { "type": "null" },
              "effectiveRef": { "type": "null" },
              "decisionReceiptRef": { "type": "null" },
              "legacyProjectRefs": { "minItems": 1 }
            }
          }
        },
        {
          "if": { "properties": { "guidelineDisposition": { "const": "linked" } }, "required": ["guidelineDisposition"] },
          "then": {
            "properties": {
              "guidelineRefs": { "minItems": 1 },
              "guidelineRelationships": { "minItems": 1 }
            }
          }
        },
        {
          "if": { "properties": { "guidelineDisposition": { "const": "no_applicable_guideline" } }, "required": ["guidelineDisposition"] },
          "then": {
            "properties": {
              "guidelineRefs": { "maxItems": 0 },
              "guidelineRelationships": { "maxItems": 0 }
            }
          }
        },
        {
          "if": { "properties": { "approvalState": { "const": "approved" } }, "required": ["approvalState"] },
          "then": {
            "properties": {
              "effectiveRef": { "$ref": "#/$defs/safePath" },
              "decisionReceiptRef": { "$ref": "#/$defs/safePath" }
            }
          }
        },
        {
          "if": { "properties": { "lifecycleState": { "enum": ["active", "done"] } }, "required": ["lifecycleState"] },
          "then": {
            "properties": {
              "approvalState": { "const": "approved" },
              "guidelineDisposition": { "enum": ["linked", "no_applicable_guideline"] }
            }
          }
        }
      ]
    }
  }
}
