{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://document-harness.dev/schemas/migration-evidence-pack.schema.json",
  "title": "Document Harness Migration Evidence Pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "release", "targetSourceRevision", "installationReceiptRef", "humanDecisionReceiptRefs", "gates", "allRequiredGatesPassed", "humanReviewComplete", "rollbackRef"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "release": {
      "type": "object",
      "required": ["id", "version", "manifestSha256", "sourceRevision"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" },
        "manifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sourceRevision": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "targetSourceRevision": { "type": "string", "minLength": 1 },
    "installationReceiptRef": { "type": "string", "minLength": 1 },
    "humanDecisionReceiptRefs": { "type": "array", "items": { "type": "string" } },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "required", "result", "evidenceRef", "evidenceSha256"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "result": { "enum": ["passed", "failed", "blocked", "not_run"] },
          "evidenceRef": { "type": "string", "minLength": 1 },
          "evidenceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "allRequiredGatesPassed": { "type": "boolean" },
    "humanReviewComplete": { "type": "boolean" },
    "rollbackRef": { "type": ["string", "null"] }
  }
}
